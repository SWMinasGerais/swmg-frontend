<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="800" height="800" viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path d="M300,150 Q400,100 500,150 Q600,200 650,300 Q700,400 650,500 Q600,600 500,650 Q400,700 300,650 Q200,600 150,500 Q100,400 150,300 Q200,200 300,150 Z" 
    fill="none" 
    stroke="#0F3460" 
    stroke-width="10"
  />
  
  <!-- Belo Horizonte marker -->
  <circle cx="400" cy="400" r="20" fill="#FFCC00" />
  <text x="400" y="400" text-anchor="middle" dominant-baseline="middle" font-family="Arial" font-size="12" fill="#0F3460" font-weight="bold">BH</text>
  
  <!-- Uberlândia marker -->
  <circle cx="200" cy="300" r="15" fill="#FFCC00" />
  <text x="200" y="300" text-anchor="middle" dominant-baseline="middle" font-family="Arial" font-size="10" fill="#0F3460" font-weight="bold">UDI</text>
  
  <!-- Juiz de Fora marker -->
  <circle cx="600" cy="450" r="15" fill="#FFCC00" />
  <text x="600" y="450" text-anchor="middle" dominant-baseline="middle" font-family="Arial" font-size="10" fill="#0F3460" font-weight="bold">JF</text>
  
  <!-- Montes Claros marker -->
  <circle cx="350" cy="200" r="15" fill="#FFCC00" />
  <text x="350" y="200" text-anchor="middle" dominant-baseline="middle" font-family="Arial" font-size="10" fill="#0F3460" font-weight="bold">MC</text>
  
  <text x="400" y="100" text-anchor="middle" font-family="Arial" font-size="24" fill="#0F3460" font-weight="bold">Minas Gerais</text>
</svg> 