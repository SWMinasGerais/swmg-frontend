<!-- Barra do governo-->
<div id="barra-brasil" style="background:#7F7F7F; height: 20px; padding:0 0 0 10px;display:block;"> 
	<ul id="menu-barra-temp" style="list-style:none;">
		<li style="display:inline; float:left;padding-right:10px; margin-right:10px; border-right:1px solid #EDEDED"><a href="https://brasil.gov.br" style="font-family:sans,sans-serif; text-decoration:none; color:white;">Portal do Governo Brasileiro</a></li> 
		<li><a style="font-family:sans,sans-serif; text-decoration:none; color:white;" href="https://epwg.governoeletronico.gov.br/barra/atualize.html">Atualize sua Barra de Governo</a></li>
	</ul>
</div>

<div id="page" class="site">
	
	<header id="masthead" class="site-header" role="banner">
		<div class="site-branding container">
			<div class="row">
				<div class="header-logo">
					<a href="https://www.ufv.br" class="custom-logo-link" rel="home" itemprop="url"><img width="300" height="90" src="/wp-content/themes/portalnovo/assets/images/logotipoUFV2.png" class="custom-logo" alt="UFV" itemprop="logo"></a>
				</div>

				<!-- Barra de pesquisa -->
				<div class="newspaper-x-blog-sidebar">
					<div id="search-2" class="widget widget_search">
						<div class="Campus">
							<a href="/campus-vicosa/">CAMPUS VIÇOSA</a>
							<a href="/campus-florestal/">CAMPUS FLORESTAL</a>
							<a href="/campus-rio-paranaiba/">CAMPUS RIO PARANAÍBA</a>
						</div>
						<form role="search" method="get" class="search-right" id="searchform" action="https://www.ufv.br/">
							<label>
								<span class="screen-reader-text">Search for:</span>
								<input class="search-field" placeholder="Pesquisar..." value="" name="s" type="search">
							</label>
							<button class="search-submit" value="Search  " type="submit"><span class="fa fa-search"></span></button>
						</form>
						<span class="Facebook"><a href="https://www.facebook.com/ufvbr" target="_blank"><img src="/wp-content/themes/portalnovo/assets/images/menu_facebook.png" class="redesocial" alt="Facebook" title="Titulo: Facebook" style="margin-bottom: 4px;"></a></span>
