  .jss13 {
    gap: 0.75rem;
    width: max-content;
    cursor: pointer;
    display: flex;
    opacity: unset;
    padding: 12px 0;
    min-width: 240px;
    transition: all 300ms;
    align-items: center;
    font-weight: 500;
    margin-bottom: 0;
    pointer-events: unset;
  }
  .jss13 .department-icon svg {
    right: unset;
    bottom: unset;
    position: unset;
  }
  .jss13 .department-icon img {
    filter: invert(81%) sepia(2%) saturate(1793%) hue-rotate(187deg) brightness(80%) contrast(77%);
    object-fit: contain;
  }
  .jss13:hover .department-icon img {
    filter: none;
    transition: all 300ms;
  }
